# Copy to .env and fill in. NEVER commit .env or put secrets in the frontend.

# --- AI (optional: the platform works with authored fallback content without it) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Server ---
PORT=3001
# Comma-separated list of allowed frontend origins in production, e.g. https://neuroplay.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# --- Database (optional: without it, a local JSON file store is used) ---
# MongoDB Atlas connection string, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/neuroplay
MONGODB_URI=

# --- Auth ---
# Long random string for signing JWTs. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset in development, a random secret is generated and stored in server/.data/jwt-secret
JWT_SECRET=